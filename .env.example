# Cổng chạy Web Server
PORT=3000

# Khóa API OpenAI (tùy chọn - nếu không điền, AI Box sẽ tự động chạy ở chế độ Local Smart AI Engine)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cấu hình Email SMTP (tùy chọn - nếu không điền, hệ thống sẽ tự động chạy mô phỏng gửi email)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
